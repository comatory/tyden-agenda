{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/tyden-agenda.schema.json",
  "title": "tyden agenda data source",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeRange", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "timeRange": {
      "$ref": "#/$defs/timeRange"
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "day": {
      "type": "string",
      "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "start", "end"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "start", "end", "title"],
      "properties": {
        "day": {
          "$ref": "#/$defs/day"
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": ["normal", "muted", "outline"]
        }
      }
    }
  }
}
